{
  "name": "lucky-money-2027",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm run client\" \"npm run server\"",
    "client": "node start-vite.mjs --host 0.0.0.0 --config vite.config.mjs --configLoader runner",
    "server": "node server.js",
    "build": "node start-vite.mjs build --config vite.config.mjs --configLoader runner",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:tree": "node --test --experimental-test-isolation=none tests/peach-*.test.mjs tests/player-session.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.1.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
