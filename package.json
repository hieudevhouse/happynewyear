{
  "name": "lucky-money-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node start-vite.mjs --host 0.0.0.0 --config vite.config.mjs --configLoader runner",
    "build": "node start-vite.mjs build --config vite.config.mjs --configLoader runner",
    "preview": "node start-vite.mjs preview --host 0.0.0.0 --config vite.config.mjs --configLoader runner",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:tree": "node --test --experimental-test-isolation=none tests/peach-*.test.mjs tests/player-session.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.1.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "vite": "^6.0.7"
  }
}
