# Browser requests use the frontend origin; Vercel and Vite proxy /api to the backend.
# Vite embeds this public value during the build.
VITE_API_BASE_URL=/api

# Vite dev/preview proxy target. Production routing is configured in vercel.json.
# Use http://127.0.0.1:4000 here to develop against a local backend.
API_PROXY_TARGET=https://happynewyear-backend.vercel.app
